# =====================================================================
# Bybit Testnet Configuration
# =====================================================================
# Generate API keys on Bybit Testnet:
# https://testnet.bybit.com -> Account & Security -> API Management -> Create New Key
# Ensure permissions include: Contract / Options / Orders / Positions
# =====================================================================

BYBIT_API_KEY=your_testnet_api_key_here
BYBIT_API_SECRET=your_testnet_api_secret_here

# Trading node identifier (Format: NAME-ID)
TRADER_ID=BTC-STRADDLE-001

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================================================================
# Milestone 4 Execution Controls
# =====================================================================
# Controlled execution flag: Set to 'true' to submit live orders to Bybit Testnet.
# Default is 'false' (DRY-RUN mode: identifies straddle and simulates orders).
EXECUTE_TRADES=false

# Order type: LIMIT or MARKET (Default: LIMIT)
ORDER_TYPE=LIMIT

# Order quantity per option leg in BTC contracts (e.g. 0.01)
# If empty, automatically selects smallest valid lot size from instrument specs.
ORDER_QUANTITY=
